<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Network, Camera & File Uploads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_dojo_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_dojo_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.KOMS"
        android:usesCleartextTraffic="true"> <!-- Required for localhost / local IP testing -->

        <!-- Primary WebView Activity (Full KOMS Web Portal) -->
        <activity
            android:name=".ui.webview.WebViewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Native Login Activity -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true" />

        <!-- Native Student Dashboard -->
        <activity
            android:name=".ui.student.StudentDashboardActivity"
            android:exported="true" />

        <!-- Native Master Dashboard -->
        <activity
            android:name=".ui.master.MasterDashboardActivity"
            android:exported="true" />

        <!-- Other Sub-Activities -->
        <activity
            android:name=".ui.student.DojosActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.AttendanceActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.FeesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.GradingActivity"
            android:exported="false" />

    </application>

</manifest>
