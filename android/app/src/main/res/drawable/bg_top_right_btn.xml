<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFCC00">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#E61A1A1A" />
            <stroke
                android:width="1dp"
                android:color="#4DFFCC00" />
            <padding
                android:left="12dp"
                android:top="7dp"
                android:right="12dp"
                android:bottom="7dp" />
        </shape>
    </item>
</ripple>
