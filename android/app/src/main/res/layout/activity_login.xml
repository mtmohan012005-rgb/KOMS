<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <!-- Logo Animation Wrapper (Steps 1-3) -->
            <FrameLayout
                android:id="@+id/logoWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <!-- Golden Flare Effect -->
                <View
                    android:id="@+id/flareView"
                    android:layout_width="3dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:background="#FFFFFF" />

                <!-- Logo Halves (Steps 1 & 2) -->
                <FrameLayout
                    android:id="@+id/logoHalvesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivLogoLeft"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/shorin_ryu_crest"
                        android:contentDescription="Shorin Ryu Logo Left Half" />

                    <ImageView
                        android:id="@+id/ivLogoRight"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/shorin_ryu_crest"
                        android:contentDescription="Shorin Ryu Logo Right Half" />
                </FrameLayout>

                <!-- Full Joined Logo (Step 3 & 4) -->
                <ImageView
                    android:id="@+id/ivLogoFull"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/shorin_ryu_crest"
                    android:contentDescription="Shorin Ryu Logo" />
            </FrameLayout>

            <!-- Title Section (Step 4) -->
            <LinearLayout
                android:id="@+id/titleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MASS DRAGON DOJO"
                    android:textColor="#FFCC00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Karate Organization Management System (KOMS)"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Login Form Card (Steps 5 & 6) -->
            <LinearLayout
                android:id="@+id/loginFormCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Email Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_email"
                        app:tint="#777777" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Username / Email"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#777777"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:inputType="textEmailAddress" />
                </LinearLayout>

                <!-- Password Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock"
                        app:tint="#777777" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#777777"
                        android:textSize="13sp"
                        android:maxLines="1" />

                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_eye"
                        app:tint="#777777"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Login Button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_login_button"
                        android:text="Login →"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- 1-Click Demo Accounts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ QUICK 1-CLICK DEMO"
                        android:textColor="#FFCC00"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/btnDemoStudent"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_demo_pill"
                            android:gravity="center"
                            android:text="🥋 Student"
                            android:textColor="#CCCCCC"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/btnDemoMaster"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_demo_pill"
                            android:gravity="center"
                            android:text="⛩️ Master"
                            android:textColor="#CCCCCC"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/btnDemoAdmin"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_demo_pill"
                            android:gravity="center"
                            android:text="👑 Admin"
                            android:textColor="#CCCCCC"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Footer Text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="Dream  •  Discipline  •  Dojo"
                    android:textColor="#555555"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
